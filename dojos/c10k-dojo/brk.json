{
  "schema_version": 1,
  "state_dir": ".c10k-dojo",
  "modality": "code",
  "initial_mode": "local-jailed",
  "initial_spine": "workspace/echo.rb",
  "initial_extra": {
    "tier": "none"
  },
  "hooks": {
    "session_context": "hooks/session-context.txt",
    "title_prefix": "c10k-dojo",
    "command_warnings": [
      {
        "command": "docker",
        "message": "Docker not found so /c10k-dojo:bench is disabled until installed. "
      }
    ],
    "path_warnings": [
      {
        "kind": "dir",
        "path": "docs",
        "message": "Offline docs bundle missing in this project so run /c10k-dojo:setup first. "
      }
    ]
  }
}
